
---
import Layout from "../layouts/Layout.astro";

const noticias = [
  {
    categoria: "Turismo",
    titulo: "Mindo, un paraíso natural por descubrir",
    resumen:
      "Descubre la biodiversidad, los paisajes y las experiencias que hacen especial a nuestra comunidad.",
    fecha: "15 oct. 2026",
    icono: "🌿",
  },
  {
    categoria: "Comunidad",
    titulo: "Juntos por una comunidad sostenible",
    resumen:
      "Las iniciativas locales ayudan a proteger el entorno natural y a construir un mejor futuro.",
    fecha: "14 oct. 2026",
    icono: "🌎",
  },
  {
    categoria: "Emprendimiento",
    titulo: "El talento local que impulsa a Mindo",
    resumen:
      "Conoce las ideas y los pequeños negocios que fortalecen la economía de nuestra comunidad.",
    fecha: "12 oct. 2026",
    icono: "🏪",
  },
];

const negocios = [
  {
    nombre: "Sabores de Mindo",
    tipo: "Gastronomía",
    descripcion:
      "Una propuesta para disfrutar de la gastronomía y los sabores locales.",
    icono: "🍽️",
  },
  {
    nombre: "Aventuras en Mindo",
    tipo: "Turismo de naturaleza",
    descripcion:
      "Experiencias para explorar los paisajes y la biodiversidad de la zona.",
    icono: "🦋",
  },
  {
    nombre: "Hospedaje Natural",
    tipo: "Alojamiento",
    descripcion:
      "Una alternativa para descansar y disfrutar del entorno natural.",
    icono: "🏡",
  },
];
---

<Layout titulo="Inicio">
  <main>
    <section class="hero">
      <div class="container hero-content">
        <span class="eyebrow">LA VOZ DE NUESTRA COMUNIDAD</span>

        <h1>Mindo tiene mucho que contar.</h1>

        <p class="hero-description">
          Noticias, naturaleza, cultura y emprendimientos.
          Conectamos a nuestra comunidad con todo lo que hace especial a Mindo.
        </p>

        <div class="hero-actions">
          <a class="btn" href="/noticias/">Leer noticias →</a>
          <a class="btn btn-outline" href="/turismo/">Descubrir Mindo</a>
        </div>

        <div class="hero-stats">
          <div>
            <strong>Comunidad</strong>
            <span>Historias locales</span>
          </div>
          <div>
            <strong>Naturaleza</strong>
            <span>Riqueza natural</span>
          </div>
          <div>
            <strong>Emprendimiento</strong>
            <span>Talento local</span>
          </div>
        </div>
      </div>

      <div class="hero-decoration" aria-hidden="true">
        <span>🌿</span>
        <span>🦜</span>
        <span>🍃</span>
      </div>
    </section>

    <section class="section" id="noticias">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">ENTÉRATE</span>
            <h2 class="section-title">Historias de Mindo</h2>
            <p class="section-description">
              Información, iniciativas y acontecimientos de nuestra comunidad.
            </p>
          </div>

          <a class="text-link" href="/noticias/">Ver noticias →</a>
        </div>

        <div class="news-grid">
          {noticias.map((noticia) => (
            <article class="news-card">
              <div class="news-illustration">
                <span>{noticia.icono}</span>
                <span class="news-category">{noticia.categoria}</span>
              </div>

              <div class="news-body">
                <span class="news-date">{noticia.fecha}</span>
                <h3>{noticia.titulo}</h3>
                <p>{noticia.resumen}</p>
                <a class="text-link" href="/noticias/">
                  Explorar noticias →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="community-section">
      <div class="container community-grid">
        <div class="community-illustration" aria-hidden="true">
          <span class="big-leaf">🌱</span>
          <span class="floating-leaf">🍃</span>
          <span class="community-caption">Nuestra tierra, nuestra historia</span>
        </div>

        <div class="community-content">
          <span class="section-kicker">NUESTRA IDENTIDAD</span>
          <h2 class="section-title">Un lugar lleno de vida y oportunidades.</h2>
          <p>
            Mindo es naturaleza, cultura, trabajo y comunidad. Queremos dar
            visibilidad a las personas, historias e iniciativas que hacen
            crecer nuestra localidad.
          </p>

          <ul class="values-list">
            <li><span>✓</span> Información para la comunidad</li>
            <li><span>✓</span> Compromiso con la sostenibilidad</li>
            <li><span>✓</span> Apoyo a los emprendimientos locales</li>
          </ul>

          <a class="btn" href="/contacto/">Conoce nuestra iniciativa →</a>
        </div>
      </div>
    </section>

    <section class="section businesses-section" id="emprendimientos">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">TALENTO LOCAL</span>
            <h2 class="section-title">Emprendimientos de Mindo</h2>
            <p class="section-description">
              Descubre los servicios y las iniciativas de nuestra comunidad.
            </p>
          </div>

          <a class="text-link" href="/negocios/">Ver emprendimientos →</a>
        </div>

        <div class="business-grid">
          {negocios.map((negocio) => (
            <article class="business-card">
              <div class="business-icon" aria-hidden="true">
                {negocio.icono}
              </div>

              <span class="business-type">{negocio.tipo}</span>
              <h3>{negocio.nombre}</h3>
              <p>{negocio.descripcion}</p>

              <a class="text-link" href="/negocios/">
                Conocer más →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container cta-content">
        <span class="section-kicker">SEAMOS PARTE DEL CAMBIO</span>
        <h2>Tu historia también merece ser contada.</h2>
        <p>
          ¿Tienes una noticia, una idea o un emprendimiento que quieras compartir?
          Nos encantará conocerlo.
        </p>
        <a class="btn cta-btn" href="/contacto/">Conectemos con Mindo →</a>
      </div>
    </section>
  </main>
</Layout>


<style>
  .container {
    width: min(1120px, 90%);
    margin-inline: auto;
  }

  /* PORTADA */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 90px 0 55px;
    background: linear-gradient(
      135deg,
      #eaf4ff 0%,
      #f7fbff 60%,
      #d6eaff 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .eyebrow,
  .section-kicker {
    color: #1976d2;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.7px;
  }

  .hero h1 {
    max-width: 750px;
    margin: 18px 0;
    color: #123b66;
    font-size: clamp(42px, 6.5vw, 76px);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -2px;
  }

  .hero-description {
    max-width: 620px;
    color: #526477;
    font-size: 17px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  /* BOTONES */
  .btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 13px 21px;
    border: 2px solid #1976d2;
    border-radius: 8px;
    background: #1976d2;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .btn:hover {
    transform: translateY(-2px);
    background: #123b66;
    border-color: #123b66;
  }

  .btn-outline {
    background: transparent;
    color: #1976d2;
  }

  .btn-outline:hover {
    color: #ffffff;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 45px;
    margin-top: 55px;
    padding-top: 25px;
    border-top: 1px solid #c4dcf5;
  }

  .hero-stats div {
    display: grid;
    gap: 5px;
  }

  .hero-stats strong {
    color: #123b66;
    font-size: 14px;
  }

  .hero-stats span {
    color: #64748b;
    font-size: 12px;
  }

  .hero-decoration {
    position: absolute;
    right: 8%;
    bottom: 15%;
    display: flex;
    gap: 10px;
    align-items: center;
    opacity: 0.35;
    font-size: clamp(30px, 5vw, 65px);
    transform: rotate(-12deg);
  }

  /* SECCIÓN DE NOTICIAS */
  .section {
    padding: 75px 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 32px;
  }

  .section-title {
    margin: 10px 0;
    color: #123b66;
    font-size: clamp(27px, 4vw, 38px);
    line-height: 1.2;
  }

  .section-description {
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  .text-link {
    color: #1976d2;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .text-link:hover {
    color: #123b66;
    text-decoration: underline;
  }

  .news-grid,
  .business-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .news-card {
    overflow: hidden;
    border: 1px solid #d6e6f5;
    border-radius: 14px;
    background: #ffffff;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .news-card:hover,
  .business-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(18, 59, 102, 0.10);
  }

  .news-illustration {
    display: flex;
    min-height: 160px;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20px;
    background: linear-gradient(135deg, #eaf4ff, #d6eaff);
  }

  .news-illustration > span:first-child {
    align-self: center;
    padding: 10px;
    font-size: 55px;
  }

  .news-category {
    padding: 6px 10px;
    border-radius: 20px;
    background: #ffffff;
    color: #1976d2;
    font-size: 11px;
    font-weight: 800;
  }

  .news-body {
    padding: 22px;
  }

  .news-date {
    color: #64748b;
    font-size: 11px;
  }

  .news-body h3,
  .business-card h3 {
    margin: 10px 0;
    color: #123b66;
    font-size: 19px;
    line-height: 1.4;
  }

  .news-body p,
  .business-card p {
    min-height: 65px;
    margin-bottom: 18px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.8;
  }

  /* IDENTIDAD DE LA COMUNIDAD */
  .community-section {
    padding: 75px 0;
    background: #f0f7ff;
  }

  .community-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: center;
  }

  .community-illustration {
    position: relative;
    display: grid;
    min-height: 320px;
    place-items: center;
    overflow: hidden;
    border-radius: 20px;
    background: linear-gradient(145deg, #dceeff, #b8d8f5);
  }

  .big-leaf {
    font-size: 115px;
  }

  .floating-leaf {
    position: absolute;
    top: 35px;
    right: 40px;
    font-size: 50px;
  }

  .community-caption {
    position: absolute;
    right: 20px;
    bottom: 20px;
    left: 20px;
    padding: 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.88);
    color: #123b66;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }

  .community-content > p {
    color: #64748b;
    font-size: 14px;
    line-height: 1.9;
  }

  .values-list {
    display: grid;
    gap: 13px;
    margin: 25px 0;
    padding: 0;
    list-style: none;
  }

  .values-list li {
    display: flex;
    gap: 10px;
    align-items: center;
    color: #334155;
    font-size: 13px;
  }

  .values-list li span {
    display: grid;
    width: 23px;
    height: 23px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 50%;
    background: #d6eaff;
    color: #1976d2;
    font-weight: 800;
  }

  /* EMPRENDIMIENTOS */
  .businesses-section {
    background: #ffffff;
  }

  .business-card {
    padding: 25px;
    border: 1px solid #d6e6f5;
    border-radius: 14px;
    background: #ffffff;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .business-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border-radius: 14px;
    background: #eaf4ff;
    font-size: 29px;
  }

  .business-type {
    display: block;
    margin-top: 20px;
    color: #1976d2;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  /* LLAMADO A LA ACCIÓN */
  .cta-section {
    padding: 70px 0;
    background: #123b66;
    text-align: center;
  }

  .cta-content {
    max-width: 750px;
  }

  .cta-section .section-kicker {
    color: #a9d3ff;
  }

  .cta-section h2 {
    margin: 15px 0;
    color: #ffffff;
    font-size: clamp(30px, 4.5vw, 45px);
    line-height: 1.2;
  }

  .cta-section p {
    max-width: 600px;
    margin: 0 auto 25px;
    color: #dbeafe;
    font-size: 14px;
    line-height: 1.8;
  }

  .cta-btn {
    border-color: #ffffff;
    background: #ffffff;
    color: #123b66;
  }

  .cta-btn:hover {
    border-color: #eaf4ff;
    background: #eaf4ff;
    color: #123b66;
  }

  /* DISEÑO PARA CELULARES */
  @media (max-width: 760px) {
    .hero {
      padding-top: 65px;
    }

    .hero-decoration {
      right: 5%;
      bottom: 20%;
      opacity: 0.16;
    }

    .hero-stats {
      gap: 22px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .news-grid,
    .business-grid,
    .community-grid {
      grid-template-columns: 1fr;
    }

    .community-grid {
      gap: 35px;
    }

    .community-illustration {
      min-height: 250px;
    }
  }
</style>
