
---
import Layout from "../layouts/Layout.astro";

const noticias = [
  {
    categoria: "Turismo",
    titulo: "Mindo, un paraíso natural por descubrir",
    resumen:
      "Descubre la biodiversidad, los paisajes y las experiencias que hacen especial a nuestra comunidad.",
    fecha: "15 oct. 2026",
    icono: "🌿",
  },
  {
    categoria: "Comunidad",
    titulo: "Juntos por una comunidad sostenible",
    resumen:
      "Las iniciativas locales ayudan a proteger el entorno natural y a construir un mejor futuro.",
    fecha: "14 oct. 2026",
    icono: "🌎",
  },
  {
    categoria: "Emprendimiento",
    titulo: "El talento local que impulsa a Mindo",
    resumen:
      "Conoce las ideas y los pequeños negocios que fortalecen la economía de nuestra comunidad.",
    fecha: "12 oct. 2026",
    icono: "🏪",
  },
];

const negocios = [
  {
    nombre: "Sabores de Mindo",
    tipo: "Gastronomía",
    descripcion:
      "Una propuesta para disfrutar de la gastronomía y los sabores locales.",
    icono: "🍽️",
  },
  {
    nombre: "Aventuras en Mindo",
    tipo: "Turismo de naturaleza",
    descripcion:
      "Experiencias para explorar los paisajes y la biodiversidad de la zona.",
    icono: "🦋",
  },
  {
    nombre: "Hospedaje Natural",
    tipo: "Alojamiento",
    descripcion:
      "Una alternativa para descansar y disfrutar del entorno natural.",
    icono: "🏡",
  },
];
---

<Layout titulo="Inicio">
  <main>
    <!-- PORTADA -->
    <section class="hero">
      <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-two" aria-hidden="true"></div>

      <div class="container hero-content">
        <span class="eyebrow">
          <span class="eyebrow-dot"></span>
          LA VOZ DE NUESTRA COMUNIDAD
        </span>

        <h1>
          Mindo tiene mucho que
          <span>contar.</span>
        </h1>

        <p class="hero-description">
          Noticias, naturaleza, cultura y emprendimientos.
          Conectamos a nuestra comunidad con todo lo que hace especial a Mindo.
        </p>

        <div class="hero-actions">
          <a class="btn" href="/noticias/">Leer noticias <span>→</span></a>
          <a class="btn btn-outline" href="/turismo/">Descubrir Mindo</a>
        </div>

        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number">01</span>
            <div>
              <strong>Comunidad</strong>
              <span>Historias locales</span>
            </div>
          </div>

          <div class="stat-item">
            <span class="stat-number">02</span>
            <div>
              <strong>Naturaleza</strong>
              <span>Riqueza natural</span>
            </div>
          </div>

          <div class="stat-item">
            <span class="stat-number">03</span>
            <div>
              <strong>Emprendimiento</strong>
              <span>Talento local</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-decoration" aria-hidden="true">
        <span>🌿</span>
        <span>🦜</span>
        <span>🍃</span>
      </div>

      <div class="hero-bottom-line" aria-hidden="true"></div>
    </section>

    <!-- NOTICIAS -->
    <section class="section news-section" id="noticias">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">ENTÉRATE</span>
            <h2 class="section-title">Historias de Mindo</h2>
            <p class="section-description">
              Información, iniciativas y acontecimientos de nuestra comunidad.
            </p>
          </div>

          <a class="text-link" href="/noticias/">Ver noticias <span>→</span></a>
        </div>

        <div class="news-grid">
          {noticias.map((noticia, index) => (
            <article class="news-card">
              <div class={`news-illustration news-illustration-${index + 1}`}>
                <span class="news-number">0{index + 1}</span>
                <span class="news-emoji">{noticia.icono}</span>
                <span class="news-category">{noticia.categoria}</span>
              </div>

              <div class="news-body">
                <span class="news-date">{noticia.fecha}</span>
                <h3>{noticia.titulo}</h3>
                <p>{noticia.resumen}</p>
                <a class="text-link" href="/noticias/">
                  Explorar noticias <span>→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- IDENTIDAD DE LA COMUNIDAD -->
    <section class="community-section">
      <div class="container community-grid">
        <div class="community-illustration" aria-hidden="true">
          <div class="illustration-orbit orbit-one"></div>
          <div class="illustration-orbit orbit-two"></div>
          <span class="big-leaf">🌱</span>
          <span class="floating-leaf floating-leaf-one">🍃</span>
          <span class="floating-leaf floating-leaf-two">🌿</span>
          <span class="community-caption">Nuestra tierra, nuestra historia</span>
          <span class="illustration-label">MINDO · ECUADOR</span>
        </div>

        <div class="community-content">
          <span class="section-kicker">NUESTRA IDENTIDAD</span>
          <h2 class="section-title">
            Un lugar lleno de vida y <span>oportunidades.</span>
          </h2>

          <p>
            Mindo es naturaleza, cultura, trabajo y comunidad. Queremos dar
            visibilidad a las personas, historias e iniciativas que hacen
            crecer nuestra localidad.
          </p>

          <ul class="values-list">
            <li><span>✓</span> Información para la comunidad</li>
            <li><span>✓</span> Compromiso con la sostenibilidad</li>
            <li><span>✓</span> Apoyo a los emprendimientos locales</li>
          </ul>

          <a class="btn" href="/cultura/">
            Explorar nuestra comunidad <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- EMPRENDIMIENTOS -->
    <section class="section businesses-section" id="emprendimientos">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">TALENTO LOCAL</span>
            <h2 class="section-title">Emprendimientos de Mindo</h2>
            <p class="section-description">
              Descubre los servicios y las iniciativas de nuestra comunidad.
            </p>
          </div>

          <a class="text-link" href="/emprendimientos/">
            Ver emprendimientos <span>→</span>
          </a>
        </div>

        <div class="business-grid">
          {negocios.map((negocio, index) => (
            <article class={`business-card business-card-${index + 1}`}>
              <div class="business-card-top">
                <div class="business-icon" aria-hidden="true">
                  {negocio.icono}
                </div>
                <span class="business-index">0{index + 1}</span>
              </div>

              <span class="business-type">{negocio.tipo}</span>
              <h3>{negocio.nombre}</h3>
              <p>{negocio.descripcion}</p>

              <a class="text-link" href="/emprendimientos/">
                Conocer más <span>→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CIERRE VISUAL -->
    <section class="closing-section">
      <div class="container closing-content">
        <span class="closing-kicker">MINDO COMUNICA</span>
        <h2>Las historias de Mindo merecen ser contadas.</h2>
        <p>
          Descubre lo que sucede, conoce a nuestra gente y mantente conectado
          con la comunidad.
        </p>
        <a class="closing-btn" href="/noticias/">
          Descubrir historias <span>→</span>
        </a>
      </div>
      <span class="closing-decoration" aria-hidden="true">M</span>
    </section>
  </main>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .container {
    width: min(1120px, 90%);
    margin-inline: auto;
  }

  /* COLORES Y PORTADA */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 90px 0 45px;
    background: linear-gradient(135deg, #123b5d 0%, #1769aa 58%, #205b91 100%);
    color: #dceeff;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-glow {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-glow-one {
    top: -230px;
    right: -100px;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(185, 220, 255, 0.22), transparent 70%);
  }

  .hero-glow-two {
    right: 18%;
    bottom: -330px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(90, 169, 238, 0.22), transparent 70%);
  }

  .eyebrow,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #1769aa;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.8px;
  }

  .hero .eyebrow {
    color: #dceeff;
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b9dcff;
    box-shadow: 0 0 15px rgba(185, 220, 255, 0.8);
  }

  .hero h1 {
    max-width: 780px;
    margin: 22px 0;
    color: #f0f7ff;
    font-size: clamp(43px, 7vw, 78px);
    font-weight: 850;
    line-height: 1.04;
    letter-spacing: -2.8px;
  }

  .hero h1 span {
    display: block;
    color: #b9dcff;
  }

  .hero-description {
    max-width: 610px;
    margin: 0;
    color: #dceeff;
    font-size: 16px;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    margin-top: 30px;
  }

  .btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 13px 21px;
    border: 1px solid #1769aa;
    border-radius: 9px;
    background: #1769aa;
    color: #f0f7ff;
    font-size: 13px;
    font-weight: 750;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s, border-color 0.2s;
  }

  .btn:hover {
    transform: translateY(-3px);
    border-color: #b9dcff;
    background: #123b5d;
  }

  .btn span,
  .text-link span,
  .closing-btn span {
    font-size: 17px;
    transition: transform 0.2s;
  }

  .btn:hover span,
  .text-link:hover span,
  .closing-btn:hover span {
    transform: translateX(3px);
  }

  .hero .btn {
    border-color: #b9dcff;
    background: #b9dcff;
    color: #123b5d;
  }

  .hero .btn:hover {
    background: #dceeff;
  }

  .hero .btn-outline {
    border-color: rgba(220, 238, 255, 0.65);
    background: rgba(18, 59, 93, 0.25);
    color: #f0f7ff;
  }

  .hero .btn-outline:hover {
    background: rgba(220, 238, 255, 0.15);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 58px;
    padding-top: 25px;
    border-top: 1px solid rgba(220, 238, 255, 0.25);
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 190px;
    margin: 0 34px 10px 0;
  }

  .stat-number {
    color: #b9dcff;
    font-size: 24px;
    font-weight: 850;
    letter-spacing: -1px;
  }

  .stat-item div {
    display: grid;
    gap: 5px;
  }

  .hero-stats strong {
    color: #f0f7ff;
    font-size: 13px;
  }

  .hero-stats span:not(.stat-number) {
    color: #b9dcff;
    font-size: 11px;
  }

  .hero-decoration {
    position: absolute;
    right: 7%;
    bottom: 24%;
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0.3;
    font-size: clamp(34px, 5vw, 65px);
    transform: rotate(-12deg);
    pointer-events: none;
  }

  .hero-bottom-line {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 5px;
    background: linear-gradient(90deg, #b9dcff, #1769aa, #dceeff);
  }

  /* NOTICIAS */
  .section {
    padding: 78px 0;
  }

  .news-section {
    background: #dceeff;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 32px;
  }

  .section-title {
    margin: 11px 0;
    color: #123b5d;
    font-size: clamp(28px, 4vw, 39px);
    font-weight: 850;
    line-height: 1.2;
    letter-spacing: -1px;
  }

  .section-description {
    max-width: 560px;
    margin: 0;
    color: #365b7b;
    font-size: 13px;
    line-height: 1.8;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #1769aa;
    font-size: 12px;
    font-weight: 850;
    text-decoration: none;
    transition: color 0.2s;
  }

  .text-link:hover {
    color: #123b5d;
  }

  .news-grid,
  .business-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .news-card {
    overflow: hidden;
    border: 1px solid rgba(23, 105, 170, 0.14);
    border-radius: 16px;
    background: #c5e1fb;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .news-card:hover,
  .business-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(18, 59, 93, 0.14);
  }

  .news-illustration {
    position: relative;
    display: grid;
    min-height: 170px;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(140deg, #1769aa, #123b5d);
  }

  .news-illustration-2 {
    background: linear-gradient(140deg, #205b91, #1769aa);
  }

  .news-illustration-3 {
    background: linear-gradient(140deg, #123b5d, #347fb7);
  }

  .news-number {
    position: absolute;
    top: 12px;
    left: 17px;
    color: rgba(220, 238, 255, 0.55);
    font-size: 13px;
    font-weight: 850;
    letter-spacing: 1px;
  }

  .news-emoji {
    font-size: 62px;
    filter: drop-shadow(0 8px 10px rgba(18, 59, 93, 0.18));
    transition: transform 0.25s;
  }

  .news-card:hover .news-emoji {
    transform: scale(1.08) rotate(-4deg);
  }

  .news-category {
    position: absolute;
    bottom: 13px;
    left: 14px;
    padding: 7px 11px;
    border: 1px solid rgba(220, 238, 255, 0.28);
    border-radius: 20px;
    background: rgba(18, 59, 93, 0.65);
    color: #f0f7ff;
    font-size: 10px;
    font-weight: 800;
    backdrop-filter: blur(8px);
  }

  .news-body {
    padding: 22px;
  }

  .news-date {
    color: #426989;
    font-size: 11px;
    font-weight: 650;
  }

  .news-body h3,
  .business-card h3 {
    margin: 11px 0;
    color: #123b5d;
    font-size: 18px;
    font-weight: 850;
    line-height: 1.45;
  }

  .news-body p,
  .business-card p {
    min-height: 68px;
    margin: 0 0 20px;
    color: #365b7b;
    font-size: 12px;
    line-height: 1.9;
  }

  /* COMUNIDAD: SECCIÓN OSCURA */
  .community-section {
    position: relative;
    overflow: hidden;
    padding: 82px 0;
    background: linear-gradient(130deg, #123b5d, #174e7a);
  }

  .community-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: center;
  }

  .community-illustration {
    position: relative;
    display: grid;
    min-height: 350px;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(220, 238, 255, 0.2);
    border-radius: 22px;
    background: linear-gradient(145deg, #1769aa, #205b91 55%, #123b5d);
  }

  .community-illustration::before,
  .community-illustration::after {
    position: absolute;
    width: 230px;
    height: 230px;
    border: 1px solid rgba(220, 238, 255, 0.2);
    border-radius: 50%;
    content: "";
  }

  .community-illustration::after {
    width: 310px;
    height: 310px;
  }

  .illustration-orbit {
    position: absolute;
    border: 1px solid rgba(220, 238, 255, 0.16);
    border-radius: 50%;
  }

  .orbit-one {
    width: 390px;
    height: 390px;
  }

  .orbit-two {
    width: 460px;
    height: 460px;
  }

  .big-leaf {
    position: relative;
    z-index: 1;
    font-size: 115px;
    filter: drop-shadow(0 12px 14px rgba(18, 59, 93, 0.25));
  }

  .floating-leaf {
    position: absolute;
    z-index: 1;
    font-size: 44px;
  }

  .floating-leaf-one {
    top: 40px;
    right: 45px;
  }

  .floating-leaf-two {
    bottom: 75px;
    left: 35px;
    font-size: 35px;
  }

  .community-caption {
    position: absolute;
    right: 20px;
    bottom: 20px;
    left: 20px;
    z-index: 2;
    padding: 13px;
    border: 1px solid rgba(220, 238, 255, 0.22);
    border-radius: 10px;
    background: rgba(18, 59, 93, 0.8);
    color: #dceeff;
    font-size: 12px;
    font-weight: 750;
    text-align: center;
    backdrop-filter: blur(8px);
  }

  .illustration-label {
    position: absolute;
    top: 20px;
    left: 20px;
    color: #b9dcff;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 1.5px;
  }

  .community-content .section-kicker {
    color: #b9dcff;
  }

  .community-content .section-title {
    color: #f0f7ff;
    font-size: clamp(29px, 4vw, 42px);
  }

  .community-content .section-title span {
    color: #b9dcff;
  }

  .community-content > p {
    color: #d0e5f8;
    font-size: 13px;
    line-height: 1.95;
  }

  .values-list {
    display: grid;
    gap: 14px;
    margin: 25px 0 28px;
    padding: 0;
    list-style: none;
  }

  .values-list li {
    display: flex;
    gap: 11px;
    align-items: center;
    color: #e5f2ff;
    font-size: 12px;
  }

  .values-list li span {
    display: grid;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 7px;
    background: #b9dcff;
    color: #123b5d;
    font-size: 13px;
    font-weight: 900;
  }

  .community-content .btn {
    border-color: #b9dcff;
    background: #b9dcff;
    color: #123b5d;
  }

  .community-content .btn:hover {
    border-color: #dceeff;
    background: #dceeff;
  }

  /* EMPRENDIMIENTOS */
  .businesses-section {
    background: #b9dcff;
  }

  .business-card {
    padding: 25px;
    border: 1px solid rgba(23, 105, 170, 0.16);
    border-radius: 16px;
    background: #cfe6fc;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .business-card-2 {
    background: #c4e1fb;
  }

  .business-card-3 {
    background: #dceeff;
  }

  .business-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .business-icon {
    display: grid;
    width: 60px;
    height: 60px;
    place-items: center;
    border: 1px solid rgba(23, 105, 170, 0.12);
    border-radius: 16px;
    background: #b9dcff;
    font-size: 29px;
    transition: transform 0.2s;
  }

  .business-card:hover .business-icon {
    transform: rotate(-5deg) scale(1.05);
  }

  .business-index {
    color: #6287a6;
    font-size: 13px;
    font-weight: 850;
    letter-spacing: 1px;
  }

  .business-type {
    display: block;
    margin-top: 22px;
    color: #1769aa;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  /* CIERRE AZUL */
  .closing-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 76px 0;
    background: linear-gradient(115deg, #1769aa, #123b5d);
    text-align: center;
  }

  .closing-content {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .closing-kicker {
    color: #b9dcff;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 2px;
  }

  .closing-section h2 {
    margin: 17px 0;
    color: #f0f7ff;
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 850;
    line-height: 1.2;
    letter-spacing: -1.3px;
  }

  .closing-section p {
    max-width: 570px;
    margin: 0 auto 26px;
    color: #dceeff;
    font-size: 13px;
    line-height: 1.9;
  }

  .closing-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border: 1px solid #b9dcff;
    border-radius: 9px;
    background: #b9dcff;
    color: #123b5d;
    font-size: 13px;
    font-weight: 850;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s;
  }

  .closing-btn:hover {
    transform: translateY(-3px);
    background: #dceeff;
  }

  .closing-decoration {
    position: absolute;
    z-index: -1;
    right: 4%;
    bottom: -150px;
    color: rgba(220, 238, 255, 0.07);
    font-size: 440px;
    font-weight: 900;
    line-height: 1;
    pointer-events: none;
  }

  /* ACCESIBILIDAD */
  a:focus-visible {
    outline: 3px solid #5ca9ee;
