astro
---
import Layout from "../layouts/Layout.astro";

const imagenFondo = "/img/mindo_inicio_fondo.png";
const imagenComunidad = "/img/mindo_noticias_fondo.png";

const noticias = [
  {
    categoria: "Turismo",
    titulo: "Mindo, un paraíso natural por descubrir",
    resumen: "Descubre la biodiversidad, los paisajes y las experiencias que hacen especial a nuestra comunidad.",
    fecha: "15 oct. 2026",
    imagen: "/img/mindo_paraiso.png",
    alt: "Bosque natural de Mindo",
  },
  {
    categoria: "Comunidad",
    titulo: "Juntos por una comunidad sostenible",
    resumen: "Las iniciativas locales ayudan a proteger el entorno natural y a construir un mejor futuro.",
    fecha: "14 oct. 2026",
    imagen: "/img/mindo_sostenible.png",
    alt: "Naturaleza y biodiversidad",
  },
  {
    categoria: "Emprendimiento",
    titulo: "El talento local que impulsa a Mindo",
    resumen: "Conoce las ideas y los pequeños negocios que fortalecen la economía de nuestra comunidad.",
    fecha: "12 oct. 2026",
    imagen: "/img/talento_local.png",
    alt: "Cafetería y emprendimiento local",
  },
];

const negocios = [
  {
    nombre: "Sabores de Mindo",
    tipo: "Gastronomía",
    descripcion: "Una propuesta para disfrutar de la gastronomía y los sabores locales.",
    imagen: "/img/sabores_mindo.png",
    alt: "Gastronomía local de Mindo",
  },
  {
    nombre: "Aventuras en Mindo",
    tipo: "Turismo de naturaleza",
    descripcion: "Experiencias para explorar los paisajes y la biodiversidad de la zona.",
    imagen: "/img/aventuras_mindo.png",
    alt: "Experiencias de turismo de naturaleza",
  },
  {
    nombre: "Hospedaje Natural",
    tipo: "Alojamiento",
    descripcion: "Una alternativa para descansar y disfrutar del entorno natural.",
    imagen: "/img/hospedaje_mindo.png",
    alt: "Hospedaje rodeado de naturaleza",
  },
];
---

<Layout titulo="Inicio">
  <main>
    <!-- PORTADA -->
    <section class="hero" style={`--imagen-fondo: url('${imagenFondo}')`}>
      <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-two" aria-hidden="true"></div>

      <div class="container hero-content">
        <div class="hero-text-box">
          <span class="eyebrow">
            <span class="eyebrow-dot"></span>
            LA VOZ DE NUESTRA COMUNIDAD
          </span>

          <h1>Mindo tiene mucho que <span>contar.</span></h1>

          <p class="hero-description">
            Noticias, naturaleza, cultura y emprendimientos.
            Conectamos a nuestra comunidad con todo lo que hace especial a Mindo.
          </p>
        </div>

        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number">01</span>
            <div><strong>Comunidad</strong><span>Historias locales</span></div>
          </div>
          <div class="stat-item">
            <span class="stat-number">02</span>
            <div><strong>Naturaleza</strong><span>Riqueza natural</span></div>
          </div>
          <div class="stat-item">
            <span class="stat-number">03</span>
            <div><strong>Emprendimiento</strong><span>Talento local</span></div>
          </div>
        </div>
      </div>

      <div class="hero-bottom-line" aria-hidden="true"></div>
    </section>

    <!-- HISTORIAS DE MINDO -->
    <section class="section news-section" id="noticias">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">ENTÉRATE</span>
            <h2 class="section-title">Historias de Mindo</h2>
            <p class="section-description">
              Información, iniciativas y acontecimientos de nuestra comunidad.
            </p>
          </div>

          <a class="text-link" href="/noticias/">Ver noticias <span>→</span></a>
        </div>

        <div class="news-grid">
          {noticias.map((noticia, index) => (
            <article class="news-card">
              <div class="news-image">
                <img src={noticia.imagen} alt={noticia.alt} loading="lazy" />
                <span class="news-number">0{index + 1}</span>
                <span class="news-category">{noticia.categoria}</span>
              </div>

              <div class="news-body">
                <span class="news-date">{noticia.fecha}</span>
                <h3>{noticia.titulo}</h3>
                <p>{noticia.resumen}</p>
                <a class="text-link" href="/noticias/">Explorar noticias <span>→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- IDENTIDAD DE LA COMUNIDAD -->
    <section class="community-section">
      <div class="container community-grid">

        <div class="community-illustration">
          <img
            src={imagenComunidad}
            alt="Paisaje natural de Mindo, Ecuador"
            class="community-image"
            loading="lazy"
          />

          <div class="community-image-overlay"></div>

          <span class="community-caption">
            Nuestra tierra, nuestra historia
          </span>

          <span class="illustration-label">
            MINDO · ECUADOR
          </span>
        </div>

        <div class="community-content">
          <span class="section-kicker">NUESTRA IDENTIDAD</span>

          <h2 class="section-title">
            Un lugar lleno de vida y <span>oportunidades.</span>
          </h2>

          <p>
            Mindo es naturaleza, cultura, trabajo y comunidad. Queremos dar
            visibilidad a las personas, historias e iniciativas que hacen
            crecer nuestra localidad.
          </p>

          <ul class="values-list">
            <li><span>✓</span> Información para la comunidad</li>
            <li><span>✓</span> Compromiso con la sostenibilidad</li>
            <li><span>✓</span> Apoyo a los emprendimientos locales</li>
          </ul>

          <a class="btn" href="/cultura/">
            Explorar nuestra comunidad <span>→</span>
          </a>
        </div>

      </div>
    </section>

    <!-- EMPRENDIMIENTOS -->
    <section class="section businesses-section" id="emprendimientos">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-kicker">TALENTO LOCAL</span>
            <h2 class="section-title">Emprendimientos de Mindo</h2>
            <p class="section-description">
              Descubre los servicios y las iniciativas de nuestra comunidad.
            </p>
          </div>

          <a class="text-link" href="/emprendimientos/">
            Ver emprendimientos <span>→</span>
          </a>
        </div>

        <div class="business-grid">
          {negocios.map((negocio, index) => (
            <article class={`business-card business-card-${index + 1}`}>
              <div class="business-card-top">
                <div class="business-image">
                  <img
                    src={negocio.imagen}
                    alt={negocio.alt}
                    loading="lazy"
                  />
                </div>

                <span class="business-index">0{index + 1}</span>
              </div>

              <span class="business-type">{negocio.tipo}</span>
              <h3>{negocio.nombre}</h3>
              <p>{negocio.descripcion}</p>

              <a class="text-link" href="/emprendimientos/">
                Conocer más <span>→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CIERRE VISUAL -->
    <section class="closing-section">
      <div class="container closing-content">
        <span class="closing-kicker">MINDO COMUNICA</span>
        <h2>Las historias de Mindo merecen ser contadas.</h2>
        <p>
          Descubre lo que sucede, conoce a nuestra gente y mantente conectado
          con la comunidad.
        </p>
        <a class="closing-btn" href="/noticias/">
          Descubrir historias <span>→</span>
        </a>
      </div>

      <span class="closing-decoration" aria-hidden="true">M</span>
    </section>
  </main>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .container {
    width: min(1120px, 90%);
    margin-inline: auto;
  }

  /* PORTADA */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 90px 0 45px;
    background-image:
      linear-gradient(
        110deg,
        rgba(18, 59, 93, 0.82),
        rgba(23, 105, 170, 0.58)
      ),
      var(--imagen-fondo);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: #dceeff;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-text-box {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: min(110%, 6000px);
    padding: 55px 60px;
    border: 1px solid rgba(220, 238, 255, 0.22);
    border-radius: 28px;
    background: rgba(18, 59, 93, 0.40);
    box-shadow: 0 18px 45px rgba(18, 59, 93, 0.25);
  }

  .hero-glow {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-glow-one {
    top: -230px;
    right: -100px;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(185, 220, 255, 0.22), transparent 70%);
  }

  .hero-glow-two {
    right: 18%;
    bottom: -330px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(90, 169, 238, 0.22), transparent 70%);
  }

  .eyebrow,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #1769aa;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.8px;
  }

  .hero .eyebrow {
    color: #dceeff;
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b9dcff;
    box-shadow: 0 0 15px rgba(185, 220, 255, 0.8);
  }

  .hero h1 {
    max-width: 780px;
    margin: 22px 0;
    color: #f0f7ff;
    font-size: clamp(43px, 7vw, 78px);
    font-weight: 850;
    line-height: 1.04;
    letter-spacing: -2.8px;
  }

  .hero h1 span {
    display: block;
    color: #b9dcff;
  }

  .hero-description {
    max-width: 610px;
    margin: 0;
    color: #dceeff;
    font-size: 16px;
    line-height: 1.9;
  }

  .btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 13px 21px;
    border: 1px solid #1769aa;
    border-radius: 9px;
    background: #1769aa;
    color: #f0f7ff;
    font-size: 13px;
    font-weight: 750;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s, border-color 0.2s;
  }

  .btn:hover {
    transform: translateY(-3px);
    border-color: #b9dcff;
    background: #123b5d;
  }

  .btn span,
  .text-link span,
  .closing-btn span {
    font-size: 17px;
    transition: transform 0.2s;
  }

  .btn:hover span,
  .text-link:hover span,
  .closing-btn:hover span {
    transform: translateX(3px);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    margin-top: 58px;
    padding-top: 25px;
    border-top: 1px solid rgba(220, 238, 255, 0.25);
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 190px;
    margin: 0 34px 10px 0;
  }

  .stat-number {
    color: #b9dcff;
    font-size: 24px;
    font-weight: 850;
    letter-spacing: -1px;
  }

  .stat-item div {
    display: grid;
    gap: 5px;
  }

  .hero-stats strong {
    color: #f0f7ff;
    font-size: 13px;
  }

  .hero-stats span:not(.stat-number) {
    color: #b9dcff;
    font-size: 11px;
  }

  .hero-bottom-line {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 5px;
    background: linear-gradient(90deg, #b9dcff, #1769aa, #dceeff);
  }

  /* SECCIONES GENERALES */
  .section {
    padding: 78px 0;
  }

  .news-section {
    background: #dceeff;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 32px;
  }

  .section-title {
    margin: 11px 0;
    color: #123b5d;
    font-size: clamp(28px, 4vw, 39px);
    font-weight: 850;
    line-height: 1.2;
    letter-spacing: -1px;
  }

  .section-description {
    max-width: 560px;
    margin: 0;
    color: #365b7b;
    font-size: 13px;
    line-height: 1.8;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #1769aa;
    font-size: 12px;
    font-weight: 850;
    text-decoration: none;
    transition: color 0.2s;
  }

  .text-link:hover {
    color: #123b5d;
  }

  /* HISTORIAS DE MINDO */
  .news-grid,
  .business-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .news-card {
    overflow: hidden;
    border: 1px solid rgba(23, 105, 170, 0.14);
    border-radius: 16px;
    background: #c5e1fb;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .news-card:hover,
  .business-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(18, 59, 93, 0.14);
  }

  .news-image {
    position: relative;
    height: 220px;
    overflow: hidden;
    background: #b9dcff;
  }

  .news-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .news-card:hover .news-image img {
    transform: scale(1.08);
  }

  .news-number {
    position: absolute;
    top: 14px;
    left: 16px;
    z-index: 1;
    color: #f0f7ff;
    font-size: 14px;
    font-weight: 850;
    text-shadow: 0 2px 8px rgba(18, 59, 93, 0.7);
  }

  .news-category {
    position: absolute;
    bottom: 14px;
    left: 14px;
    padding: 8px 13px;
    border: 1px solid rgba(220, 238, 255, 0.5);
    border-radius: 20px;
    background: rgba(18, 59, 93, 0.82);
    color: #f0f7ff;
    font-size: 10px;
    font-weight: 800;
    backdrop-filter: blur(8px);
  }

  .news-body {
    padding: 22px;
  }

  .news-date {
    color: #426989;
    font-size: 11px;
    font-weight: 650;
  }

  .news-body h3,
  .business-card h3 {
    margin: 11px 0;
    color: #123b5d;
    font-size: 18px;
    font-weight: 850;
    line-height: 1.45;
  }

  .news-body p,
  .business-card p {
    min-height: 68px;
    margin: 0 0 20px;
    color: #365b7b;
    font-size: 12px;
    line-height: 1.9;
  }

  /* COMUNIDAD */
  .community-section {
    position: relative;
    overflow: hidden;
    padding: 82px 0;
    background: linear-gradient(130deg, #123b5d, #174e7a);
  }

  .community-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: center;
  }

  .community-illustration {
    position: relative;
    min-height: 430px;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(220, 238, 255, 0.2);
    border-radius: 22px;
    background: #123b5d;
  }

  .community-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .community-image-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(18, 59, 93, 0.08),
      rgba(18, 59, 93, 0.72)
    );
  }

  .community-caption {
    position: absolute;
    right: 20px;
    bottom: 65px;
    left: 20px;
    z-index: 2;
    color: #f0f7ff;
    font-size: 1.35rem;
    font-weight: 750;
    text-align: center;
    text-shadow: 0 2px 10px rgba(18, 59, 93, 0.65);
  }

  .illustration-label {
    position: absolute;
    bottom: 25px;
    left: 28px;
    z-index: 2;
    color: #dceeff;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 1.5px;
  }

  .community-content .section-kicker {
    color: #b9dcff;
  }

  .community-content .section-title {
    color: #f0f7ff;
    font-size: clamp(29px, 4vw, 42px);
  }

  .community-content .section-title span {
    color: #b9dcff;
  }

  .community-content > p {
    color: #d0e5f8;
    font-size: 13px;
    line-height: 1.95;
  }

  .values-list {
    display: grid;
    gap: 14px;
    margin: 25px 0 28px;
    padding: 0;
    list-style: none;
  }

  .values-list li {
    display: flex;
    gap: 11px;
    align-items: center;
    color: #e5f2ff;
    font-size: 12px;
  }

  .values-list li span {
    display: grid;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 7px;
    background: #b9dcff;
    color: #123b5d;
    font-size: 13px;
    font-weight: 900;
  }

  .community-content .btn {
    border-color: #b9dcff;
    background: #b9dcff;
    color: #123b5d;
  }

  .community-content .btn:hover {
    border-color: #dceeff;
    background: #dceeff;
  }

  /* EMPRENDIMIENTOS */
  .businesses-section {
    background: #b9dcff;
  }

  .business-card {
    padding: 25px;
    border: 1px solid rgba(23, 105, 170, 0.16);
    border-radius: 16px;
    background: #cfe6fc;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .business-card-2 {
    background: #c4e1fb;
  }

  .business-card-3 {
    background: #dceeff;
  }

  .business-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  /* IMÁGENES GRANDES DE EMPRENDIMIENTOS */
  .business-image {
    width: 100%;
    height: 240px;
    overflow: hidden;
    border: 1px solid rgba(23, 105, 170, 0.12);
    border-radius: 14px;
    background: #b9dcff;
  }

  .business-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }

  .business-card:hover .business-image img {
    transform: scale(1.06);
  }

  .business-index {
    flex-shrink: 0;
    color: #6287a6;
    font-size: 13px;
    font-weight: 850;
    letter-spacing: 1px;
  }

  .business-type {
    display: block;
    margin-top: 22px;
    color: #1769aa;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  /* CIERRE */
  .closing-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 76px 0;
    background: linear-gradient(115deg, #1769aa, #123b5d);
    text-align: center;
  }

  .closing-content {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .closing-kicker {
    color: #b9dcff;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 2px;
  }

  .closing-section h2 {
    margin: 17px 0;
    color: #f0f7ff;
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 850;
    line-height: 1.2;
    letter-spacing: -1.3px;
  }

  .closing-section p {
    max-width: 570px;
    margin: 0 auto 26px;
    color: #dceeff;
    font-size: 13px;
    line-height: 1.9;
  }

  .closing-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border: 1px solid #b9dcff;
    border-radius: 9px;
    background: #b9dcff;
    color: #123b5d;
    font-size: 13px;
    font-weight: 850;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s;
  }

  .closing-btn:hover {
    transform: translateY(-3px);
    background: #dceeff;
  }

  .closing-decoration {
    position: absolute;
    z-index: -1;
    right: 4%;
    bottom: -150px;
    color: rgba(220, 238, 255, 0.07);
    font-size: 440px;
    font-weight: 900;
    line-height: 1;
    pointer-events: none;
  }

  /* ACCESIBILIDAD */
  a:focus-visible {
    outline: 3px solid #5ca9ee;
    outline-offset: 4px;
  }

  /* TABLETAS */
  @media (max-width: 900px) {
    .community-grid {
      grid-template-columns: 1fr 1fr;
      gap: 35px;
    }

    .stat-item {
      margin-right: 20px;
    }

    .news-grid,
    .business-grid {
      gap: 15px;
    }

    .news-body,
    .business-card {
      padding: 18px;
    }

    .business-image {
      height: 210px;
    }
  }

  /* CELULARES */
  @media (max-width: 760px) {
    .hero {
      padding-top: 65px;
    }

    .hero h1 {
      letter-spacing: -1.7px;
    }

    .hero-text-box {
      width: 100%;
      padding: 36px 28px;
      border-radius: 22px;
    }

    .hero-stats {
      gap: 15px;
      margin-top: 42px;
    }

    .stat-item {
      min-width: 145px;
      margin-right: 8px;
    }

    .section {
      padding: 58px 0;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .news-grid,
    .business-grid,
    .community-grid {
      grid-template-columns: 1fr;
    }

    .news-grid,
