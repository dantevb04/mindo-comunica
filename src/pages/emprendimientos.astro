
---
import Layout from "../layouts/Layout.astro";

const negocios = [
  {
    nombre: "Sabores de Mindo",
    tipo: "Restaurante",
    categoria: "Gastronomía local",
    descripcion:
      "Una propuesta gastronómica de ejemplo inspirada en los sabores y productos de la región.",
    direccion: "Centro de Mindo",
    imagen:
      "/img/gastronomia.png",
    destacado: true,
  },
  {
    nombre: "Mindo Bird Adventure",
    tipo: "Turismo",
    categoria: "Naturaleza y aventura",
    descripcion:
      "Una experiencia turística de demostración para descubrir senderos, aves y paisajes naturales.",
    direccion: "Mindo, Ecuador",
    imagen:
      "/img/aves.png",
    destacado: true,
  },
  {
    nombre: "Artesanías del Bosque",
    tipo: "Artesanía",
    categoria: "Arte y creatividad",
    descripcion:
      "Una muestra de cómo los emprendimientos artesanales pueden compartir su creatividad con la comunidad.",
    direccion: "Centro de Mindo",
    imagen:
      "/img/artesanias.png",
    destacado: false,
  },
  {
    nombre: "Hospedaje Bosque Verde",
    tipo: "Hospedaje",
    categoria: "Descanso y naturaleza",
    descripcion:
      "Un ejemplo de alojamiento turístico para quienes desean disfrutar de un entorno natural.",
    direccion: "Mindo, Ecuador",
    imagen:
      "/img/hospedajes.png",
    destacado: false,
  },
  {
    nombre: "Chocolate de Mindo",
    tipo: "Comercio",
    categoria: "Productos locales",
    descripcion:
      "Una propuesta demostrativa dedicada al chocolate y a los productos inspirados en la región.",
    direccion: "Mindo, Ecuador",
    imagen:
      "/img/chocolate.png",
    destacado: false,
  },
  {
    nombre: "Aventura en el Bosque",
    tipo: "Turismo",
    categoria: "Actividades al aire libre",
    descripcion:
      "Una idea de emprendimiento turístico centrada en experiencias de aventura y contacto con la naturaleza.",
    direccion: "Mindo, Ecuador",
    imagen:
      "/img/aventuras.png"
  },
];

const categorias = ["Todos", ...new Set(negocios.map((negocio) => negocio.tipo))];
---

<Layout
  title="Emprendimientos | Mindo Comunica"
  description="Descubre emprendimientos, comercios y servicios locales de Mindo, Ecuador."
>
  <section class="business-hero">
    <div class="container business-hero-content">
      <span class="eyebrow">TALENTO LOCAL</span>
      <h1>Los grandes proyectos nacen en nuestra comunidad.</h1>
      <p>
        Conoce las ideas, productos y servicios que dan vida a Mindo.
        Apoyar a los emprendimientos locales es impulsar el desarrollo de nuestra gente.
      </p>
      <a href="#directorio" class="btn">Explorar emprendimientos</a>
    </div>
  </section>

  <section class="section" id="directorio">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">DIRECTORIO LOCAL</span>
          <h2 class="section-title">Conoce los emprendimientos</h2>
          <p class="section-description">
            Un espacio para descubrir diferentes propuestas de gastronomía,
            turismo, hospedaje y creatividad.
          </p>
        </div>
        <span class="business-count">{negocios.length} propuestas</span>
      </div>

      <div class="category-filters" aria-label="Filtrar por categoría">
        {categorias.map((categoria, indice) => (
          <button
            type="button"
            class:list={["filter-button", { active: indice === 0 }]}
            data-category={categoria}
            aria-pressed={indice === 0 ? "true" : "false"}
          >
            {categoria}
          </button>
        ))}
      </div>

      <div class="business-grid" id="business-grid">
        {negocios.map((negocio) => (
          <article
            class="business-card"
            data-type={negocio.tipo}
          >
            <div class="business-image-wrap">
              <img
                src={negocio.imagen}
                alt={negocio.categoria}
                class="business-image"
                loading="lazy"
              />
              <span class="business-type">{negocio.tipo}</span>
              {negocio.destacado && (
                <span class="featured-label">Destacado</span>
              )}
            </div>

            <div class="business-content">
              <span class="business-category">{negocio.categoria}</span>
              <h3>{negocio.nombre}</h3>
              <p>{negocio.descripcion}</p>

              <div class="business-address">
                <span aria-hidden="true">📍</span>
                <span>{negocio.direccion}</span>
              </div>

        
            </div>
          </article>
        ))}
      </div>

      <p class="no-results" id="no-results" hidden>
        No hay emprendimientos en esta categoría.
      </p>

      <div class="demo-note">
        <span class="demo-icon" aria-hidden="true">ℹ</span>
        <p>
          <strong>Directorio de demostración:</strong> los nombres y las
          descripciones son ejemplos para presentar el diseño del sitio.
          No representan necesariamente negocios reales ni contactos verificados.
        </p>
      </div>
    </div>
  </section>

  
</Layout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    ".filter-button",
  );
  const businessCards = document.querySelectorAll<HTMLElement>(
    ".business-card",
  );
  const noResults = document.querySelector<HTMLElement>("#no-results");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.dataset.category || "Todos";
      let visibleCount = 0;

      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle("active", active);
        item.setAttribute("aria-pressed", String(active));
      });

      businessCards.forEach((card) => {
        const matches =
          category === "Todos" || card.dataset.type === category;

        card.hidden = !matches;

        if (matches) visibleCount++;
      });

      if (noResults) {
        noResults.hidden = visibleCount > 0;
      }
    });
  });
</script>


<style>
  .business-hero {
    padding: 95px 0;
    color: #fff;
    background:
      linear-gradient(90deg, rgba(18, 59, 102, 0.92), rgba(18, 59, 102, 0.6)),
      url("https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=1800&q=85")
        center / cover;
  }

  .business-hero-content {
    max-width: 1120px;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 12px;
    color: #1976d2;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1.6px;
  }

  .business-hero .eyebrow,
  .business-cta .eyebrow {
    color: #bbdefb;
  }

  .business-hero h1 {
    max-width: 760px;
    margin: 0 0 20px;
    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1.12;
  }

  .business-hero p {
    max-width: 660px;
    margin: 0 0 28px;
    color: #eaf4ff;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .section-title {
    margin: 0 0 12px;
    color: #123b66;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.2;
  }

  .section-description {
    max-width: 650px;
    margin: 0;
    color: #64748b;
  }

  .business-count {
    flex-shrink: 0;
    padding: 8px 14px;
    border-radius: 30px;
    background: #eaf4ff;
    color: #1976d2;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }

  .filter-button {
    padding: 9px 17px;
    border: 1px solid #d6e6f5;
    border-radius: 30px;
    background: #fff;
    color: #123b66;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 700;
    transition: 0.2s ease;
  }

  .filter-button:hover,
  .filter-button.active {
    border-color: #1976d2;
    background: #1976d2;
    color: #fff;
  }

  .business-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .business-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #d6e6f5;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 5px 20px rgba(18, 59, 102, 0.05);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .business-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(18, 59, 102, 0.12);
  }

  .business-card[hidden] {
    display: none;
  }

  .business-image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #eaf4ff;
  }

  .business-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .business-card:hover .business-image {
    transform: scale(1.04);
  }

  .business-type,
  .featured-label {
    position: absolute;
    top: 12px;
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .business-type {
    left: 12px;
    background: #fff;
    color: #123b66;
  }

  .featured-label {
    right: 12px;
    background: #f5d779;
    color: #533e08;
  }

  .business-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 21px;
  }

  .business-category {
    margin-bottom: 7px;
    color: #1976d2;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .business-content h3 {
    margin: 0 0 11px;
    color: #123b66;
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .business-content > p {
    margin: 0 0 17px;
    color: #64748b;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .business-address {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    color: #64748b;
    font-size: 0.88rem;
  }

  .business-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    color: #1976d2;
    font-weight: 700;
  }

  .business-link:hover {
    color: #123b66;
  }

  .business-link span {
    transition: transform 0.2s ease;
  }

  .business-link:hover span {
    transform: translateX(4px);
  }

  .no-results {
    padding: 25px;
    border-radius: 12px;
    background: #eaf4ff;
    color: #64748b;
    text-align: center;
  }

  .demo-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 30px;
    padding: 17px 20px;
    border: 1px solid #d6e6f5;
    border-radius: 12px;
    background: #f5f9ff;
    color: #123b66;
  }

  .demo-icon {
    display: grid;
    flex-shrink: 0;
    width: 25px;
    height: 25px;
    place-items: center;
    border-radius: 50%;
    background: #d6eaff;
    color: #123b66;
    font-weight: 800;
  }

  .demo-note p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .business-cta {
    padding: 58px 0;
    background: #123b66;
    color: #fff;
  }

  .cta-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .business-cta h2 {
    margin: 0 0 12px;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    line-height: 1.2;
  }

  .business-cta p {
    max-width: 650px;
    margin: 0;
    color: #eaf4ff;
    line-height: 1.7;
  }

  .btn-light {
    flex-shrink: 0;
    background: #fff;
    color: #123b66;
  }

  .btn-light:hover {
    background: #eaf4ff;
    color: #123b66;
  }

  @media (max-width: 900px) {
    .business-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .business-hero {
      padding: 75px 0;
    }
  }

  @media (max-width: 600px) {
    .business-grid {
      grid-template-columns: 1fr;
    }

    .business-hero {
      padding: 60px 0;
    }

    .section-heading,
    .cta-content {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
