---
import Layout from "../layouts/Layout.astro";

const negocios = [
  {
    nombre: "Sabores de Mindo",
    tipo: "Restaurante",
    categoria: "Gastronomía local",
    descripcion:
      "Una propuesta gastronómica de ejemplo inspirada en los sabores y productos de la región.",
    direccion: "Centro de Mindo",
    imagen: "/img/gastronomia.png",
    destacado: true,
  },
  {
    nombre: "Mindo Bird Adventure",
    tipo: "Turismo",
    categoria: "Naturaleza y aventura",
    descripcion:
      "Una experiencia turística de demostración para descubrir senderos, aves y paisajes naturales.",
    direccion: "Mindo, Ecuador",
    imagen: "/img/aves.png",
    destacado: true,
  },
  {
    nombre: "Artesanías del Bosque",
    tipo: "Artesanía",
    categoria: "Arte y creatividad",
    descripcion:
      "Una muestra de cómo los emprendimientos artesanales pueden compartir su creatividad con la comunidad.",
    direccion: "Centro de Mindo",
    imagen: "/img/artesanias.png",
    destacado: false,
  },
  {
    nombre: "Hospedaje Bosque Verde",
    tipo: "Hospedaje",
    categoria: "Descanso y naturaleza",
    descripcion:
      "Un ejemplo de alojamiento turístico para quienes desean disfrutar de un entorno natural.",
    direccion: "Mindo, Ecuador",
    imagen: "/img/hospedajes.png",
    destacado: false,
  },
  {
    nombre: "Chocolate de Mindo",
    tipo: "Comercio",
    categoria: "Productos locales",
    descripcion:
      "Una propuesta demostrativa dedicada al chocolate y a los productos inspirados en la región.",
    direccion: "Mindo, Ecuador",
    imagen: "/img/chocolate.png",
    destacado: false,
  },
  {
    nombre: "Aventura en el Bosque",
    tipo: "Turismo",
    categoria: "Actividades al aire libre",
    descripcion:
      "Una idea de emprendimiento turístico centrada en experiencias de aventura y contacto con la naturaleza.",
    direccion: "Mindo, Ecuador",
    imagen: "/img/aventuras.png",
    destacado: false,
  },
];

const categorias = [
  "Todos",
  ...new Set(negocios.map((negocio) => negocio.tipo)),
];

// Imagen de fondo de Emprendimientos
const imagenFondo = "/img/mindo_emprendimientos_fondo.png";
---

<Layout
  title="Emprendimientos | Mindo Comunica"
  description="Descubre emprendimientos, comercios y servicios locales de Mindo, Ecuador."
>

  <!-- PORTADA DE EMPRENDIMIENTOS -->
  <section
    class="business-hero"
    style={`--imagen-fondo: url('${imagenFondo}')`}
  >
    <div class="container business-hero-content">

      <span class="eyebrow">TALENTO LOCAL · DESARROLLO · COMUNIDAD</span>

      <h1>
        Los grandes proyectos nacen en nuestra comunidad.
      </h1>

      <p>
        Conoce las ideas, productos y servicios que dan vida a Mindo.
        Apoyar a los emprendimientos locales es impulsar el desarrollo de nuestra gente.
      </p>

      <a href="#directorio" class="btn">
        Explorar emprendimientos ↓
      </a>

    </div>
  </section>

  <!-- DIRECTORIO DE EMPRENDIMIENTOS -->
  <section class="section" id="directorio">
    <div class="container">

      <div class="section-heading">
        <div>
          <span class="eyebrow">DIRECTORIO LOCAL</span>

          <h2 class="section-title">
            Conoce los emprendimientos
          </h2>

          <p class="section-description">
            Un espacio para descubrir diferentes propuestas de gastronomía,
            turismo, hospedaje y creatividad.
          </p>
        </div>

        <span class="business-count">
          {negocios.length} propuestas
        </span>
      </div>

      <!-- FILTROS POR CATEGORÍA -->
      <div class="category-filters" aria-label="Filtrar por categoría">

        {categorias.map((categoria, indice) => (
          <button
            type="button"
            class:list={["filter-button", { active: indice === 0 }]}
            data-category={categoria}
            aria-pressed={indice === 0 ? "true" : "false"}
          >
            {categoria}
          </button>
        ))}

      </div>

      <!-- TARJETAS DE NEGOCIOS -->
      <div class="business-grid" id="business-grid">

        {negocios.map((negocio) => (
          <article
            class="business-card"
            data-type={negocio.tipo}
          >

            <div class="business-image-wrap">

              <img
                src={negocio.imagen}
                alt={negocio.categoria}
                class="business-image"
                loading="lazy"
              />

              <span class="business-type">
                {negocio.tipo}
              </span>

              {negocio.destacado && (
                <span class="featured-label">
                  Destacado
                </span>
              )}

            </div>

            <div class="business-content">

              <span class="business-category">
                {negocio.categoria}
              </span>

              <h3>{negocio.nombre}</h3>

              <p>{negocio.descripcion}</p>

              <div class="business-address">
                <span aria-hidden="true">📍</span>
                <span>{negocio.direccion}</span>
              </div>

            </div>

          </article>
        ))}

      </div>

      <p class="no-results" id="no-results" hidden>
        No hay emprendimientos en esta categoría.
      </p>

      <!-- AVISO INFORMATIVO -->
      <div class="demo-note">

        <span class="demo-icon" aria-hidden="true">ℹ</span>

        <p>
          <strong>Directorio de demostración:</strong> los nombres y las
          descripciones son ejemplos para presentar el diseño del sitio.
          No representan necesariamente negocios reales ni contactos verificados.
        </p>

      </div>

    </div>
  </section>

</Layout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    ".filter-button",
  );

  const businessCards = document.querySelectorAll<HTMLElement>(
    ".business-card",
  );

  const noResults = document.querySelector<HTMLElement>("#no-results");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.dataset.category || "Todos";
      let visibleCount = 0;

      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle("active", active);
        item.setAttribute("aria-pressed", String(active));
      });

      businessCards.forEach((card) => {
        const matches =
          category === "Todos" || card.dataset.type === category;

        card.hidden = !matches;

        if (matches) visibleCount++;
      });

      if (noResults) {
        noResults.hidden = visibleCount > 0;
      }
    });
  });
</script>

<style>

  /* PORTADA CON IMAGEN DE FONDO */

  .business-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: flex;
    align-items: center;

    min-height: 480px;
    padding: 90px 0;

    color: #f0f7ff;

    background-image:
      linear-gradient(
        110deg,
        rgba(18, 59, 93, 0.82),
        rgba(23, 105, 170, 0.58)
      ),
      var(--imagen-fondo);

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .business-hero-content {
    position: relative;
    z-index: 1;
    max-width: 1120px;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 12px;

    color: #1769aa;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1.6px;
  }

  .business-hero .eyebrow {
    color: #b9dcff;
  }

  .business-hero h1 {
    max-width: 760px;
    margin: 0 0 20px;

    color: #f0f7ff;
    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1.12;
  }

  .business-hero p {
    max-width: 660px;
    margin: 0 0 28px;

    color: #f0f7ff;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  /* BOTÓN */

  .business-hero .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 13px 22px;
    border-radius: 9px;

    background: #b9dcff;
    color: #123b5d;

    font-weight: 800;
    text-decoration: none;

    transition: background 0.2s, transform 0.2s;
  }

  .business-hero .btn:hover {
    background: #dceeff;
    transform: translateY(-2px);
  }

  /* ENCABEZADO DEL DIRECTORIO */

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .section-title {
    margin: 0 0 12px;

    color: #123b5d;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.2;
  }

  .section-description {
    max-width: 650px;
    margin: 0;
    color: #526b83;
  }

  .business-count {
    flex-shrink: 0;
    padding: 8px 14px;

    border-radius: 30px;
    background: #dceeff;
    color: #1769aa;

    font-size: 0.9rem;
    font-weight: 700;
  }

  /* FILTROS */

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }

  .filter-button {
    padding: 9px 17px;

    border: 1px solid #d6e6f5;
    border-radius: 30px;

    background: #eaf4ff;
    color: #123b5d;

    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 700;

    transition: 0.2s ease;
  }

  .filter-button:hover,
  .filter-button.active {
    border-color: #1769aa;
    background: #1769aa;
    color: #f0f7ff;
  }

  /* TARJETAS */

  .business-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .business-card {
    min-width: 0;
    overflow: hidden;

    border: 1px solid #d6e6f5;
    border-radius: 16px;

    background: #eaf4ff;
    box-shadow: 0 5px 20px rgba(18, 59, 102, 0.05);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .business-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(18, 59, 102, 0.12);
  }

  .business-card[hidden] {
    display: none;
  }

  .business-image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #dceeff;
  }

  .business-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .business-card:hover .business-image {
    transform: scale(1.04);
  }

  .business-type,
  .featured-label {
    position: absolute;
    top: 12px;

    padding: 6px 10px;
    border-radius: 20px;

    font-size: 0.75rem;
    font-weight: 700;
  }

  .business-type {
    left: 12px;
    background: #dceeff;
    color: #123b5d;
  }

  .featured-label {
    right: 12px;
    background: #b9dcff;
    color: #123b5d;
  }

  .business-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 21px;
  }

  .business-category {
    margin-bottom: 7px;

    color: #1769aa;
    font-size: 0.78rem;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .business-content h3 {
    margin: 0 0 11px;

    color: #123b5d;
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .business-content > p {
    margin: 0 0 17px;

    color: #526b83;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .business-address {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;

    color: #526b83;
    font-size: 0.88rem;
  }

  /* SIN RESULTADOS */

  .no-results {
    padding: 25px;
    border-radius: 12px;

    background: #dceeff;
    color: #526b83;

    text-align: center;
  }

  /* AVISO INFORMATIVO */

  .demo-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;

    margin-top: 30px;
    padding: 17px 20px;

    border: 1px solid #d6e6f5;
    border-radius: 12px;

    background: #f0f7ff;
    color: #123b5d;
  }

  .demo-icon {
    display: grid;
    flex-shrink: 0;

    width: 25px;
    height: 25px;
    place-items: center;

    border-radius: 50%;
    background: #dceeff;
    color: #123b5d;

    font-weight: 800;
  }

  .demo-note p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* TABLETS */

  @media (max-width: 900px) {
    .business-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .business-hero {
      padding: 75px 0;
    }
  }

  /* CELULARES */

  @media (max-width: 600px) {
    .business-grid {
      grid-template-columns: 1fr;
    }

    .business-hero {
      min-height: 400px;
      padding: 60px 0;
      background-position: center;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }

</style>