---
import Layout from "../layouts/Layout.astro";

const actividades = [
  {
    imagen: "/img/futbol_mindo.png",
    alt: "Actividad de fútbol",
    categoria: "FÚTBOL",
    titulo: "Pasión por el fútbol",
    descripcion:
      "Un espacio para informar sobre encuentros, equipos y actividades futbolísticas de la comunidad.",
  },
  {
    imagen: "/img/ciclismo_mindo.png",
    alt: "Actividad de ciclismo",
    categoria: "CICLISMO",
    titulo: "Aventura sobre ruedas",
    descripcion:
      "Conoce iniciativas y recorridos deportivos para disfrutar del entorno natural con responsabilidad.",
  },
  {
    imagen: "/img/atletismo_mindo.png",
    alt: "Actividad de atletismo",
    categoria: "ATLETISMO",
    titulo: "Muévete por tu bienestar",
    descripcion:
      "Promovemos la actividad física, las carreras locales y los hábitos saludables.",
  },
  {
    imagen: "/img/eventos.png",
    alt: "Eventos deportivos",
    categoria: "EVENTOS",
    titulo: "El deporte nos conecta",
    descripcion:
      "Un espacio para compartir torneos, resultados y logros de deportistas locales.",
  },
];

// Imagen de fondo de Deportes
const imagenFondo = "/img/mindo_deportes_fondo.png";
---

<Layout title="Deportes | Mindo Comunica">
  <!-- PORTADA DE DEPORTES -->
  <section
    class="sports-hero"
    style={`--imagen-fondo: url('${imagenFondo}')`}
  >
    <div class="container sports-content">
      <span class="eyebrow">ENERGÍA · EQUIPO · COMUNIDAD</span>

      <h1>
        El deporte nos<br />
        <span>mueve.</span>
      </h1>

      <p>
        Conoce las actividades deportivas, los encuentros y las historias
        de quienes representan el espíritu de nuestra comunidad.
      </p>
    </div>
  </section>

  <!-- ACTIVIDADES DEPORTIVAS -->
  <section class="section" id="actividades">
    <div class="container">
      <span class="section-label">DEPORTE LOCAL</span>

      <h2 class="section-title">Actividad, salud y compañerismo</h2>

      <p class="section-description">
        Un lugar para destacar las iniciativas deportivas y fomentar
        la participación de niños, jóvenes y adultos.
      </p>

      <div class="sports-grid">
        {actividades.map((item) => (
          <article class="sports-card">
            <div class="sports-image">
              <img
                src={item.imagen}
                alt={item.alt}
                loading="lazy"
              />
            </div>

            <div class="sports-card-content">
              <span class="category">{item.categoria}</span>

              <h3>{item.titulo}</h3>

              <p>{item.descripcion}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* PORTADA CON IMAGEN DE FONDO */
  .sports-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 480px;
    padding: 90px 0;
    color: #f0f7ff;
    background-image:
      linear-gradient(
        110deg,
        rgba(18, 59, 93, 0.82),
        rgba(23, 105, 170, 0.58)
      ),
      var(--imagen-fondo);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .sports-content {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    color: #b9dcff;
    font-size: 11px;
    letter-spacing: 1.5px;
    font-weight: 800;
  }

  .sports-hero h1 {
    margin: 20px 0;
    font-size: clamp(40px, 6vw, 66px);
    line-height: 1.08;
    color: #f0f7ff;
  }

  .sports-hero h1 span {
    color: #b9dcff;
  }

  .sports-hero p {
    max-width: 610px;
    color: #f0f7ff;
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 28px;
  }

  /* ENCABEZADOS */
  .section-label,
  .category {
    color: #1769aa;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
  }

  /* CUADRÍCULA DE ACTIVIDADES */
  .sports-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-top: 30px;
  }

  .sports-card {
    overflow: hidden;
    background: #eaf4ff;
    border: 1px solid #d6e6f5;
    border-radius: 16px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .sports-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 25px rgba(18, 59, 102, 0.12);
  }

  /* IMÁGENES DE LAS ACTIVIDADES */
  .sports-image {
    width: 100%;
    height: 260px;
    overflow: hidden;
    background: #b9dcff;
  }

  .sports-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }

  .sports-card:hover .sports-image img {
    transform: scale(1.06);
  }

  .sports-card-content {
    padding: 28px;
  }

  .sports-card h3 {
    margin: 12px 0 8px;
    font-size: 22px;
    color: #123b5d;
  }

  .sports-card p {
    color: #526b83;
    font-size: 14px;
    line-height: 1.7;
  }

  /* DISEÑO RESPONSIVE */
  @media (max-width: 600px) {
    .sports-hero {
      min-height: 400px;
      padding: 65px 0;
    }

    .sports-grid {
      grid-template-columns: 1fr;
    }

    .sports-image {
      height: 250px;
    }

    .sports-card-content {
      padding: 24px;
    }
  }
</style>