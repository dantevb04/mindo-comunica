
---
import Layout from "../layouts/Layout.astro";

const noticias = [
  {
    titulo: "Mindo impulsa el cuidado de la naturaleza",
    categoria: "Comunidad",
    resumen:
      "La comunidad promueve acciones para proteger los bosques, cuidar los espacios naturales y mantener limpio el entorno.",
    autor: "Mindo Comunica",
    fecha: "13 de octubre de 2026",
    imagen:
      "https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1000&q=80",
    etiqueta: "Medio ambiente",
  },
  {
    titulo: "Descubre la riqueza natural de Mindo",
    categoria: "Turismo",
    resumen:
      "Senderos, cascadas, aves y paisajes convierten a Mindo en un destino ideal para disfrutar y conectar con la naturaleza.",
    autor: "Mindo Comunica",
    fecha: "10 de octubre de 2026",
    imagen:
      "https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=1000&q=80",
    etiqueta: "Naturaleza",
  },
  {
    titulo: "Los emprendimientos locales fortalecen la comunidad",
    categoria: "Emprendimientos",
    resumen:
      "Los negocios locales aportan al desarrollo de Mindo y comparten productos, servicios y experiencias con sus visitantes.",
    autor: "Mindo Comunica",
    fecha: "8 de octubre de 2026",
    imagen:
      "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1000&q=80",
    etiqueta: "Economía local",
  },
  {
    titulo: "La cultura mantiene viva la identidad de Mindo",
    categoria: "Cultura",
    resumen:
      "Las tradiciones, las expresiones artísticas y las actividades comunitarias ayudan a conservar la identidad de la localidad.",
    autor: "Mindo Comunica",
    fecha: "5 de octubre de 2026",
    imagen:
      "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=1000&q=80",
    etiqueta: "Tradiciones",
  },
  {
    titulo: "El deporte promueve la unión y el bienestar",
    categoria: "Deportes",
    resumen:
      "Las actividades deportivas son una oportunidad para compartir, fomentar hábitos saludables y fortalecer los lazos comunitarios.",
    autor: "Mindo Comunica",
    fecha: "2 de octubre de 2026",
    imagen:
      "https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=1000&q=80",
    etiqueta: "Vida saludable",
  },
  {
    titulo: "Mindo, un destino para disfrutar en familia",
    categoria: "Turismo",
    resumen:
      "La tranquilidad del entorno natural y las actividades al aire libre hacen de Mindo una alternativa para compartir en familia.",
    autor: "Mindo Comunica",
    fecha: "29 de septiembre de 2026",
    imagen:
      "https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1000&q=80",
    etiqueta: "Experiencias",
  },
];
---

<Layout
  title="Noticias | Mindo Comunica"
  description="Conoce las noticias, historias y novedades de Mindo, Ecuador, en Mindo Comunica."
>
  <section class="news-hero">
    <div class="container news-hero-content">
      <span class="eyebrow">ACTUALIDAD LOCAL</span>
      <h1>Las historias de Mindo merecen ser contadas.</h1>
      <p>
        Noticias, cultura, turismo y emprendimientos de nuestra comunidad.
        Descubre lo que sucede en nuestro rincón del bosque nublado.
      </p>
      <a href="#ultimas-noticias" class="btn">Explorar noticias</a>
    </div>
  </section>

  <section class="section" id="ultimas-noticias">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">MINDO EN UN SOLO LUGAR</span>
          <h2 class="section-title">Últimas noticias</h2>
          <p class="section-description">
            Información y contenido para mantenerte conectado con nuestra
            comunidad.
          </p>
        </div>
        <span class="news-count">{noticias.length} historias</span>
      </div>

      <div class="news-grid">
        {noticias.map((noticia) => (
          <article class="news-card">
            <a
              class="news-image-link"
              href="/contacto/"
              aria-label={`Consultar sobre ${noticia.titulo}`}
            >
              <img
                src={noticia.imagen}
                alt={noticia.etiqueta}
                class="news-image"
                loading="lazy"
              />
              <span class="news-category">{noticia.categoria}</span>
            </a>

            <div class="news-card-content">
              <div class="news-meta">
                <span>{noticia.fecha}</span>
                <span class="meta-dot">•</span>
                <span>{noticia.autor}</span>
              </div>

              <h3>
                <a href="/contacto/">{noticia.titulo}</a>
              </h3>

              <p>{noticia.resumen}</p>

              <a class="read-more" href="/contacto/">
                Más información <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="demo-note">
        <span class="demo-icon" aria-hidden="true">ℹ</span>
        <p>
          <strong>Contenido demostrativo:</strong> estas noticias son ejemplos
          de presentación para el sitio web. No representan publicaciones
          periodísticas verificadas.
        </p>
      </div>
    </div>
  </section>


</Layout>


<style>
  /* PORTADA DE NOTICIAS */
  .news-hero {
    position: relative;
    overflow: hidden;
    padding: 95px 0;
    color: #ffffff;
    background:
      linear-gradient(
        90deg,
        rgba(18, 59, 102, 0.94),
        rgba(18, 59, 102, 0.68)
      ),
      url("https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1800&q=85")
        center 45% / cover;
  }

  .news-hero-content {
    position: relative;
    z-index: 1;
    max-width: 1120px;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 12px;
    color: #1976d2;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1.6px;
  }

  .news-hero .eyebrow {
    color: #b8dcff;
  }

  .news-hero h1 {
    max-width: 750px;
    margin: 0 0 20px;
    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1.12;
  }

  .news-hero p {
    max-width: 650px;
    margin: 0 0 28px;
    color: #e4efff;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  /* ENCABEZADO DE LA SECCIÓN */
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }

  .section-title {
    margin: 0 0 12px;
    color: #123b66;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.2;
  }

  .section-description {
    max-width: 650px;
    margin: 0;
    color: #64748b;
  }

  .news-count {
    flex-shrink: 0;
    padding: 8px 14px;
    border-radius: 30px;
    background: #eaf4ff;
    color: #123b66;
    font-size: 0.9rem;
    font-weight: 700;
  }

  /* CUADRÍCULA Y TARJETAS */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .news-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #d6e6f5;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 5px 20px rgba(18, 59, 102, 0.05);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .news-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(18, 59, 102, 0.12);
  }

  .news-image-link {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #eaf4ff;
  }

  .news-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .news-card:hover .news-image {
    transform: scale(1.04);
  }

  .news-category {
    position: absolute;
    bottom: 12px;
    left: 12px;
    padding: 6px 11px;
    border-radius: 20px;
    background: #1976d2;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .news-card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 21px;
  }

  .news-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    margin-bottom: 12px;
    color: #64748b;
    font-size: 0.78rem;
  }

  .meta-dot {
    color: #64b5f6;
  }

  .news-card h3 {
    margin: 0 0 12px;
    color: #123b66;
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .news-card h3 a:hover {
    color: #1976d2;
  }

  .news-card-content > p {
    margin: 0 0 18px;
    color: #64748b;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    color: #1976d2;
    font-weight: 700;
  }

  .read-more:hover {
    color: #123b66;
  }

  .read-more span {
    transition: transform 0.2s ease;
  }

  .read-more:hover span {
    transform: translateX(4px);
  }

  /* AVISO DE CONTENIDO DEMOSTRATIVO */
  .demo-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 30px;
    padding: 17px 20px;
    border: 1px solid #d6e6f5;
    border-radius: 12px;
    background: #f0f7ff;
    color: #123b66;
  }

  .demo-icon {
    display: grid;
    flex-shrink: 0;
    width: 25px;
    height: 25px;
    place-items: center;
    border-radius: 50%;
    background: #d6eaff;
    color: #123b66;
    font-weight: 800;
  }

  .demo-note p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* LLAMADO A CONTACTAR */
  .contact-cta {
    padding: 58px 0;
    background: #123b66;
    color: #ffffff;
  }

  .cta-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .contact-cta .eyebrow {
    color: #b8dcff;
  }

  .contact-cta h2 {
    margin: 0 0 12px;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    line-height: 1.2;
  }

  .contact-cta p {
    max-width: 650px;
    margin: 0;
    color: #e0edff;
    line-height: 1.7;
  }

  .btn-light {
    display: inline-flex;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    padding: 13px 21px;
    border: 2px solid #ffffff;
    border-radius: 8px;
    background: #ffffff;
    color: #123b66;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .btn-light:hover {
    transform: translateY(-2px);
    border-color: #eaf4ff;
    background: #eaf4ff;
    color: #123b66;
  }

  /* ADAPTACIÓN A TABLETS Y CELULARES */
  @media (max-width: 900px) {
    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .news-hero {
      padding: 75px 0;
    }
  }

  @media (max-width: 600px) {
    .news-grid {
      grid-template-columns: 1fr;
    }

    .news-hero {
      padding: 60px 0;
    }

    .section-heading,
    .cta-content {
      align-items: flex-start;
      flex-direction: column;
    }

    .news-count {
      align-self: flex-start;
    }
  }
</style>
