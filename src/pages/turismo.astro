---
import Layout from "../layouts/Layout.astro";

const destinos = [
  {
    nombre: "Cascadas de Mindo",
    tipo: "NATURALEZA",
    descripcion:
      "Explora senderos rodeados de vegetación y descubre la belleza de las cascadas de la zona.",
    icono: "💧",
    numero: "01",
  },
  {
    nombre: "Observación de aves",
    tipo: "AVENTURA Y FAUNA",
    descripcion:
      "Descubre la diversidad de aves que habitan el bosque nublado y sus alrededores.",
    icono: "🦜",
    numero: "02",
  },
  {
    nombre: "Canopy y aventura",
    tipo: "ADRENALINA",
    descripcion:
      "Conoce experiencias de aventura que permiten disfrutar del paisaje desde otra perspectiva.",
    icono: "🌳",
    numero: "03",
  },
  {
    nombre: "Mariposarios",
    tipo: "EDUCACIÓN AMBIENTAL",
    descripcion:
      "Aprende sobre el ciclo de vida de las mariposas y la importancia de proteger su hábitat.",
    icono: "🦋",
    numero: "04",
  },
  {
    nombre: "Ríos y senderos",
    tipo: "ECOTURISMO",
    descripcion:
      "Disfruta de espacios naturales y recorre caminos rodeados de vegetación.",
    icono: "🥾",
    numero: "05",
  },
  {
    nombre: "Cultura y gastronomía",
    tipo: "EXPERIENCIAS LOCALES",
    descripcion:
      "Conoce los sabores, las tradiciones y los emprendimientos de la comunidad.",
    icono: "🍫",
    numero: "06",
  },
];
---

<Layout titulo="Turismo">
  <section class="tour-hero">
    <div class="container">
      <span class="eyebrow">DESCUBRE UN LUGAR EXTRAORDINARIO</span>

      <h1>
        Vive la naturaleza.<br />
        <span>Descubre Mindo.</span>
      </h1>

      <p>
        Aventura, biodiversidad y experiencias que conectan a los visitantes
        con uno de los entornos naturales más especiales del Ecuador.
      </p>

      <a href="#destinos" class="btn">Explorar experiencias ↓</a>
    </div>
  </section>

  <section class="section" id="destinos">
    <div class="container">
      <span class="section-label">EXPLORA Y DISFRUTA</span>

      <h2 class="section-title">Experiencias para todos</h2>

      <p class="section-description">
        Encuentra ideas para conocer la naturaleza, vivir aventuras y descubrir
        la cultura local.
      </p>

      <div class="destination-grid">
        {destinos.map((destino) => (
          <article class="destination-card">
            <div class="destination-top">
              <span class="destination-icon">{destino.icono}</span>
              <span class="destination-number">{destino.numero}</span>
            </div>

            <span class="destination-type">{destino.tipo}</span>

            <h3>{destino.nombre}</h3>

            <p>{destino.descripcion}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="eco-section">
    <div class="container eco-content">
      <span class="section-label">TURISMO RESPONSABLE</span>

      <h2>
        Disfrutar de la naturaleza también significa protegerla.
      </h2>

      <p>
        Respeta los senderos, evita dejar basura, cuida la fauna silvestre y
        apoya a la comunidad durante tu visita.
      </p>

      
    </div>
  </section>
</Layout>


<style>
  .tour-hero {
    padding: 90px 0;
    color: white;
    background:
      linear-gradient(90deg, rgba(18, 59, 102, 0.92), rgba(18, 59, 102, 0.57)),
      url("https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1800&q=85")
        center / cover;
  }

  .eyebrow {
    color: #bbdefb;
    font-size: 11px;
    letter-spacing: 1.6px;
    font-weight: 800;
  }

  .tour-hero h1 {
    margin: 20px 0;
    font-size: clamp(40px, 6vw, 66px);
    line-height: 1.08;
    letter-spacing: -1.5px;
  }

  .tour-hero h1 span {
    color: #90caf9;
  }

  .tour-hero p {
    max-width: 610px;
    margin-bottom: 28px;
    color: #eaf4ff;
    font-size: 16px;
  }

  .section-label {
    color: #1976d2;
    font-size: 11px;
    letter-spacing: 1.5px;
    font-weight: 800;
  }

  .destination-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }

  .destination-card {
    padding: 25px;
    background: white;
    border: 1px solid #d6e6f5;
    border-radius: 15px;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .destination-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 25px rgba(18, 59, 102, 0.12);
  }

  .destination-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
  }

  .destination-icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 15px;
    background: #eaf4ff;
    font-size: 30px;
  }

  .destination-number {
    color: #b0c8df;
    font-size: 28px;
    font-weight: 800;
  }

  .destination-type {
    color: #1976d2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .destination-card h3 {
    margin: 10px 0;
    color: #123b66;
    font-size: 21px;
  }

  .destination-card p {
    margin-bottom: 0;
    color: #64748b;
    font-size: 14px;
  }

  .eco-section {
    padding: 65px 0;
    background: #eaf4ff;
  }

  .eco-content {
    max-width: 800px;
  }

  .eco-content h2 {
    max-width: 700px;
    color: #123b66;
    font-size: clamp(29px, 4vw, 42px);
    line-height: 1.2;
  }

  .eco-content p {
    max-width: 650px;
    margin-bottom: 25px;
    color: #526477;
  }

  @media (max-width: 800px) {
    .destination-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .destination-grid {
      grid-template-columns: 1fr;
    }

    .tour-hero {
      padding: 65px 0;
    }
  }
</style>
