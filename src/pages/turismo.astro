---
import Layout from "../layouts/Layout.astro";

const imagenFondo = "/img/mindo_turismo_fondo.png";

const destinos = [
  {
    nombre: "Cascadas de Mindo",
    tipo: "NATURALEZA",
    descripcion:
      "Explora senderos rodeados de vegetación y descubre la belleza de las cascadas de la zona.",
    imagen: "/img/mindo_paraiso.png",
    alt: "Cascadas y naturaleza de Mindo",
    numero: "01",
  },
  {
    nombre: "Observación de aves",
    tipo: "AVENTURA Y FAUNA",
    descripcion:
      "Descubre la diversidad de aves que habitan el bosque nublado y sus alrededores.",
    imagen: "/img/aves_mindo.png",
    alt: "Aves del bosque nublado de Mindo",
    numero: "02",
  },
  {
    nombre: "Canopy y aventura",
    tipo: "ADRENALINA",
    descripcion:
      "Conoce experiencias de aventura que permiten disfrutar del paisaje desde otra perspectiva.",
    imagen: "/img/canopy_mindo.png",
    alt: "Experiencia de canopy en Mindo",
    numero: "03",
  },
  {
    nombre: "Mariposarios",
    tipo: "EDUCACIÓN AMBIENTAL",
    descripcion:
      "Aprende sobre el ciclo de vida de las mariposas y la importancia de proteger su hábitat.",
    imagen: "/img/mariposario_mindo.png",
    alt: "Mariposas en un mariposario",
    numero: "04",
  },
  {
    nombre: "Ríos y senderos",
    tipo: "ECOTURISMO",
    descripcion:
      "Disfruta de espacios naturales y recorre caminos rodeados de vegetación.",
    imagen: "/img/rios_senderos_mindo.png",
    alt: "Ríos y senderos naturales de Mindo",
    numero: "05",
  },
  {
    nombre: "Cultura y gastronomía",
    tipo: "EXPERIENCIAS LOCALES",
    descripcion:
      "Conoce los sabores, las tradiciones y los emprendimientos de la comunidad.",
    imagen: "/img/gastronomia_turismo_mindo.png",
    alt: "Gastronomía y experiencias locales de Mindo",
    numero: "06",
  },
];
---

<Layout title="Turismo | Mindo Comunica">
  <section
    class="tour-hero"
    style={`--imagen-fondo: url('${imagenFondo}')`}
  >
    <div class="container">
      <span class="eyebrow">DESCUBRE UN LUGAR EXTRAORDINARIO</span>

      <h1>
        Vive la naturaleza.<br />
        <span>Descubre Mindo.</span>
      </h1>

      <p>
        Aventura, biodiversidad y experiencias que conectan a los visitantes
        con uno de los entornos naturales más especiales del Ecuador.
      </p>

      <a href="#destinos" class="btn">Explorar experiencias ↓</a>
    </div>
  </section>

  <section class="section" id="destinos">
    <div class="container">
      <span class="section-label">EXPLORA Y DISFRUTA</span>

      <h2 class="section-title">Experiencias para todos</h2>

      <p class="section-description">
        Encuentra ideas para conocer la naturaleza, vivir aventuras y descubrir
        la cultura local.
      </p>

      <div class="destination-grid">
        {destinos.map((destino) => (
          <article class="destination-card">
            <div class="destination-image">
              <img
                src={destino.imagen}
                alt={destino.alt}
                loading="lazy"
              />
              <span class="destination-number">{destino.numero}</span>
            </div>

            <div class="destination-content">
              <span class="destination-type">{destino.tipo}</span>

              <h3>{destino.nombre}</h3>

              <p>{destino.descripcion}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="eco-section">
    <div class="container eco-content">
      <span class="section-label">TURISMO RESPONSABLE</span>

      <h2>Disfrutar de la naturaleza también significa protegerla.</h2>

      <p>
        Respeta los senderos, evita dejar basura, cuida la fauna silvestre y
        apoya a la comunidad durante tu visita.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* PORTADA */
  .tour-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 480px;
    padding: 90px 0;
    color: #f0f7ff;
    background-image:
      linear-gradient(
        110deg,
        rgba(18, 59, 93, 0.82),
        rgba(23, 105, 170, 0.58)
      ),
      var(--imagen-fondo);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .tour-hero .container {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    color: #b9dcff;
    font-size: 11px;
    letter-spacing: 1.6px;
    font-weight: 800;
  }

  .tour-hero h1 {
    margin: 20px 0;
    font-size: clamp(40px, 6vw, 66px);
    line-height: 1.08;
    letter-spacing: -1.5px;
    color: #f0f7ff;
  }

  .tour-hero h1 span {
    color: #b9dcff;
  }

  .tour-hero p {
    max-width: 610px;
    margin-bottom: 28px;
    color: #e5f2ff;
    font-size: 16px;
    line-height: 1.8;
  }

  .btn {
    display: inline-block;
    padding: 13px 23px;
    border-radius: 8px;
    background: #b9dcff;
    color: #123b5d;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .btn:hover {
    background: #dceeff;
    transform: translateY(-2px);
  }

  /* DESTINOS */
  .section-label {
    color: #1769aa;
    font-size: 11px;
    letter-spacing: 1.5px;
    font-weight: 800;
  }

  .destination-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }

  .destination-card {
    overflow: hidden;
    background: #eaf4ff;
    border: 1px solid #d6e6f5;
    border-radius: 15px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .destination-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 25px rgba(18, 59, 93, 0.12);
  }

  /* FOTOGRAFÍAS */
  .destination-image {
    position: relative;
    width: 100%;
    height: 210px;
    overflow: hidden;
    background: #b9dcff;
  }

  .destination-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }

  .destination-card:hover .destination-image img {
    transform: scale(1.06);
  }

  .destination-number {
    position: absolute;
    top: 13px;
    right: 13px;
    display: grid;
    place-items: center;
    width: 43px;
    height: 43px;
    border-radius: 10px;
    background: rgba(220, 238, 255, 0.94);
    color: #123b5d;
    font-size: 16px;
    font-weight: 800;
  }

  .destination-content {
    padding: 23px;
  }

  .destination-type {
    color: #1769aa;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .destination-card h3 {
    margin: 10px 0;
    color: #123b5d;
    font-size: 21px;
  }

  .destination-card p {
    margin-bottom: 0;
    color: #526b83;
    font-size: 14px;
    line-height: 1.7;
  }

  /* TURISMO RESPONSABLE */
  .eco-section {
    padding: 65px 0;
    background: #dceeff;
  }

  .eco-content {
    max-width: 800px;
  }

  .eco-content h2 {
    max-width: 700px;
    color: #123b5d;
    font-size: clamp(29px, 4vw, 42px);
    line-height: 1.2;
  }

  .eco-content p {
    max-width: 650px;
    margin-bottom: 25px;
    color: #526b83;
    line-height: 1.8;
  }

  /* DISEÑO RESPONSIVE */
  @media (max-width: 800px) {
    .destination-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .destination-grid {
      grid-template-columns: 1fr;
    }

    .tour-hero {
      min-height: 400px;
      padding: 65px 0;
    }

    .destination-image {
      height: 240px;
    }
  }
</style>