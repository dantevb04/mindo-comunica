
---
const enlaces = [
  { texto: "Inicio", href: "/" },
  { texto: "Noticias", href: "/noticias/" },
  { texto: "Cultura", href: "/cultura/" },
  { texto: "Deportes", href: "/deportes/" },
  { texto: "Emprendimientos", href: "/emprendimientos/" },
  { texto: "Turismo", href: "/turismo/" },
];

const telefonoWhatsApp = "593989749675";
const mensajeWhatsApp =
  "¡Hola! Me gustaría obtener información sobre Mindo Comunica.";

const enlaceWhatsApp =
  `https://wa.me/${telefonoWhatsApp}?text=${encodeURIComponent(mensajeWhatsApp)}`;

const redes = [
  {
    nombre: "Facebook",
    href: "https://www.facebook.com/profile.php?id=61571009648202",
    icono: "facebook",
  },
  {
    nombre: "TikTok",
    href: "https://www.tiktok.com/@mindocomunicaec",
    icono: "tiktok",
  },
  {
    nombre: "Instagram",
    href: "https://www.instagram.com/mindocomunica/",
    icono: "instagram",
  },
];
---

<footer class="footer" id="footer">
  <div class="footer-contenedor">

    <!-- LOGO Y REDES SOCIALES -->
    <div class="footer-superior">
      <a href="/" class="footer-marca" aria-label="Mindo Comunica, inicio">
        <img src="/img/1.png" alt="Logo de Mindo Comunica" />

        <div class="marca-texto">
          <span class="marca-nombre">MINDO COMUNICA</span>
          <span class="marca-descripcion">
            Noticias, naturaleza y comunidad
          </span>
        </div>
      </a>

      <div class="footer-redes" aria-label="Redes sociales y contacto">

        <!-- FACEBOOK -->
        {redes.filter((red) => red.icono === "facebook").map((red) => (
          <a
            href={red.href}
            class="red-enlace"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar Facebook"
            title="Facebook"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M13.5 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.8-.1-1.7-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.3v2.2H7.3V13h2.8v8z"
              />
            </svg>
          </a>
        ))}

        <!-- WHATSAPP JUNTO A FACEBOOK -->
        <a
          href={enlaceWhatsApp}
          class="red-enlace whatsapp-enlace"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contactar por WhatsApp"
          title="WhatsApp"
        >
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path
              fill="currentColor"
              d="M16 .8A15.1 15.1 0 0 0 3.1 23.8L1 31l7.4-1.9A15.2 15.2 0 1 0 16 .8Zm0 27.6c-2.4 0-4.7-.7-6.7-2l-.5-.3-4.4 1.2 1.2-4.3-.3-.5A12.2 12.2 0 1 1 16 28.4Zm6.7-9.1c-.4-.2-2.3-1.1-2.7-1.2-.4-.1-.6-.2-.9.2-.3.4-1 1.2-1.2 1.4-.2.3-.5.3-.9.1-.4-.2-1.7-.6-3.2-2-.9-.8-1.5-1.8-1.7-2.2-.2-.4 0-.6.2-.8l.6-.7c.2-.2.3-.4.4-.7.1-.3 0-.5 0-.7l-1.2-2.8c-.3-.7-.6-.6-.9-.6h-.8c-.3 0-.7.1-1.1.5-.4.4-1.4 1.4-1.4 3.3s1.4 3.8 1.6 4.1c.2.3 2.8 4.3 6.8 6 .9.4 1.7.6 2.2.7.9.3 1.8.2 2.5.1.8-.1 2.3-.9 2.6-1.8.3-.9.3-1.7.2-1.8-.1-.2-.4-.3-.8-.5Z"
            />
          </svg>
        </a>

        <!-- TIKTOK E INSTAGRAM -->
        {redes.filter((red) => red.icono !== "facebook").map((red) => (
          <a
            href={red.href}
            class="red-enlace"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visitar ${red.nombre}`}
            title={red.nombre}
          >
            {red.icono === "tiktok" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M19.6 7.2a6.7 6.7 0 0 1-4.1-1.4v8.1a6 6 0 1 1-6-6c.4 0 .8 0 1.2.1v3.4a2.8 2.8 0 1 0 1.9 2.7V2h3.4c.2 2.2 1.6 4 3.6 4.6z"
                />
              </svg>
            )}

            {red.icono === "instagram" && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="5"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <circle cx="17.5" cy="6.8" r="1.2" fill="currentColor" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <div class="footer-linea"></div>

    <!-- ENLACES E INFORMACIÓN -->
    <div class="footer-columnas">
      <div class="footer-explora">
        <h2>EXPLORA MINDO</h2>

        <nav aria-label="Enlaces del pie de página">
          {enlaces.map((enlace) => (
            <a href={enlace.href}>{enlace.texto}</a>
          ))}
        </nav>
      </div>

      <div class="footer-info">
        <h2>INFORMACIÓN</h2>

        <a href="/#sobre-nosotros">Sobre nosotros</a>

        <a href="mailto:MINDOCOMUNICA@OUTLOOK.ES">
          MINDOCOMUNICA@OUTLOOK.ES
        </a>

        <p class="footer-ubicacion">MINDO - ECUADOR</p>

        <p>
          Un espacio para compartir noticias, cultura, turismo y las
          iniciativas de nuestra comunidad.
        </p>
      </div>
    </div>

    <div class="footer-linea"></div>

    <!-- DERECHOS RESERVADOS -->
    <div class="footer-inferior">
      <p>
        © {new Date().getFullYear()} Mindo Comunica.
        Todos los derechos reservados.
      </p>

      <a href="#top" class="volver-arriba" aria-label="Volver al inicio">
        ↑
      </a>
    </div>

  </div>
</footer>

<style>
  .footer {
    background: #123b5d;
    color: #dceeff;
    padding: 28px 0 18px;
    margin-top: 0;
    width: 100%;
  }

  .footer-contenedor {
    width: min(1160px, 90%);
    margin: 0 auto;
  }

  /* ZONA SUPERIOR */
  .footer-superior {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    padding-bottom: 24px;
  }

  .footer-marca {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .footer-marca img {
    width: 110px;
    height: 90px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .marca-texto {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .marca-nombre {
    font-size: clamp(19px, 2.4vw, 30px);
    font-weight: 800;
    letter-spacing: 1px;
    color: #dceeff;
  }

  .marca-descripcion {
    color: #b9dcff;
    font-size: 14px;
  }

  /* REDES SOCIALES Y WHATSAPP */
  .footer-redes {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .red-enlace {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: #dceeff;
    border-radius: 8px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .red-enlace svg {
    display: block;
    width: 30px;
    height: 30px;
  }

  .red-enlace:hover {
    color: #8dc5ff;
    background-color: rgba(185, 220, 255, 0.1);
    transform: translateY(-3px);
  }

  /* WHATSAPP */
 
.whatsapp-enlace {
  color: #dceeff;
}

.whatsapp-enlace:hover {
  color: #8dc5ff;
  background-color: rgba(185, 220, 255, 0.1);
}

  .red-enlace:focus-visible,
  .footer a:focus-visible {
    outline: 2px solid #8dc5ff;
    outline-offset: 4px;
  }

  /* SEPARADORES */
  .footer-linea {
    height: 1px;
    background: #45617f;
    margin-bottom: 24px;
  }

  /* COLUMNAS */
  .footer-columnas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    padding-bottom: 26px;
  }

  .footer-columnas h2 {
    font-size: 15px;
    color: #8dc5ff;
    margin: 0 0 18px;
    letter-spacing: 1px;
  }

  .footer-explora nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px 24px;
  }

  .footer-columnas a {
    color: #dceeff;
    text-decoration: none;
    font-size: 15px;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .footer-columnas a:hover {
    color: #8dc5ff;
  }

  .footer-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
  }

  .footer-info h2 {
    margin-bottom: 4px;
  }

  .footer-info p {
    max-width: 430px;
    color: #b9dcff;
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }

  .footer-info .footer-ubicacion {
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  /* PIE INFERIOR */
  .footer-inferior {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .footer-inferior p {
    font-size: 14px;
    color: #b9dcff;
    line-height: 1.6;
    margin: 0;
  }

  .volver-arriba {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #1769aa;
    color: #dceeff;
    text-decoration: none;
    font-size: 27px;
    font-weight: bold;
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  .volver-arriba:hover {
    background: #2587d5;
  }

  /* CELULARES */
  @media (max-width: 700px) {
    .footer {
      padding-top: 24px;
    }

    .footer-superior {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-marca img {
      width: 85px;
      height: 75px;
    }

    .footer-redes {
      gap: 12px;
    }

    .footer-columnas {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .footer-inferior {
      align-items: flex-start;
    }

    .footer-inferior p {
      max-width: 270px;
    }
  }

  @media (max-width: 380px) {
    .footer-marca {
      gap: 10px;
    }

    .marca-nombre {
      font-size: 18px;
    }

    .footer-explora nav {
      grid-template-columns: 1fr;
    }
  }
</style>
