
---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const { title = "Mindo Comunica" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Mindo Comunica: noticias, cultura, turismo, naturaleza y comunidad."
    />

    <meta name="theme-color" content="#0b1f3a" />

    <title>{title}</title>
  </head>

  <body id="top">
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    width: 100%;
  }
</style>
